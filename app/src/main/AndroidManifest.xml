<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions, by feature:
         SMS permissions are OPTIONAL and only used by the opt-in Smart SMS
         Tracking feature (read on-device, parsed locally, message bodies never
         stored). Without them the app works exactly as before via manual entry,
         paste or the share sheet.

         INTERNET exists ONLY for the optional, off-by-default AI-assisted
         parsing feature. It is closed by three user-controlled gates (feature
         disabled, no consent, no credential) before any text leaves the device.
         When AI is on, only messages the LOCAL filter found possibly-financial
         are sent — obvious OTPs, promotional and unrelated messages are dropped
         on-device first — and text is redacted by the prompt builder before it
         leaves. The offline ledger, manual tracking, local SMS parsing, import
         and all calculations work fully with AI off and would work with
         INTERNET removed entirely. See README "External AI". -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".KansoApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KansoSpendingTracker"
        tools:targetApi="35">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.KansoSpendingTracker">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Share-sheet import alternative: send transaction text from any
                 app — no SMS permission involved. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Live SMS detection. Only runs while Smart SMS Tracking is enabled
             in settings; the permission gate sits in the app, and bodies are
             parsed in memory only. -->
        <receiver
            android:name=".sms.SmsBroadcastReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
